# ── Docs app sign-in (src/auth.js) ───────────────────────────────────────────
# Which Denowatts backend people sign in against. Defaults to the dev backend.
VITE_BACKEND_URL=https://dev.portal.denowatts.com/backend
# Portal the "Forgot your password?" link points at.
VITE_PORTAL_URL=https://dev.portal.denowatts.com

# ── denowatts-docs-brain MCP server ──────────────────────────────────────────

# HTTP port (set this to enable HTTP mode; unset = stdio mode for local Claude Code)
MCP_HTTP_PORT=3100

# Bearer token — clients must send "Authorization: Bearer <secret>" header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable auth (only safe on a private network).
MCP_SECRET=change-me-to-a-random-secret

# GitHub token for drift checking (check_drift tool).
# Needs read access to nifty-apps/denowatts-portal and nifty-apps/denowatts-backend.
# Create at: https://github.com/settings/tokens (classic, repo:read scope)
GH_TOKEN=ghp_your_token_here
